{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AppNexus Community Apps",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["developer", "apps"],
    "additionalProperties": false,
    "properties": {
      "developer": {
        "type": "string",
        "minLength": 1,
        "description": "Your name or studio name"
      },
      "apps": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "https://apps\\.apple\\.com/.*/id[0-9]+"
        },
        "description": "Your App Store URLs"
      }
    }
  }
}
